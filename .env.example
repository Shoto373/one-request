# cp .env.example .env — дефолты рабочие для docker compose.

# --- приложение ---
APP_PORT=8080
LOG_LEVEL=INFO

# --- PostgreSQL (compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=trip
# в compose хост — db; для локального запуска без Docker замените на localhost
DATABASE_URL=postgresql://app:app@db:5432/trip

# --- LLM: любой OpenAI-совместимый провайдер ---
# Примеры LLM_BASE_URL: https://api.openai.com/v1 · https://openrouter.ai/api/v1 · https://api.deepseek.com/v1
# · локальная Ollama из контейнера: http://host.docker.internal:11434/v1 (ключ не нужен)
# Без ключа агент работает в офлайн-режиме: запрос разбирают правила, весь путь до оплаты проходит.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MODEL_FAST=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Только для GigaChat: scope OAuth-токена (GIGACHAT_API_PERS, GIGACHAT_API_B2B или GIGACHAT_API_CORP)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# auto: JSON-режим, если провайдер его поддерживает (иначе отключается сам); off: не отправлять response_format
LLM_JSON_MODE=auto

# --- поставщик travel data ---
# tutu — живой поиск билетов и отелей через официальный Tutu MCP (так работает прод);
# demo — офлайн-каталог для разработки и тестов, без сети
TRAVEL_DATA_PROVIDER=tutu
TUTU_MCP_ENDPOINT=https://mcp.tutu.ru/mcp
TUTU_TIMEOUT_SECONDS=25
# Локальные защитные лимиты одного поиска, это не лимиты, заявленные Туту
TUTU_MAX_CALLS=18
TUTU_MAX_PARALLEL=2
# pinned — записывать реальные ответы Туту в Postgres и повторять их для тех же запросов
# (стабильная демонстрация: те же цены на каждом шаге, без ожидания сети); off — всегда живой поиск
TUTU_CACHE=off
