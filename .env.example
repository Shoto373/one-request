# cp .env.example .env — дефолты рабочие для docker compose.

# --- приложение ---
APP_PORT=8080
LOG_LEVEL=INFO

# --- PostgreSQL (compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=trip
# в compose хост — db; для локального запуска без Docker замените на localhost
DATABASE_URL=postgresql://app:app@db:5432/trip

# --- LLM: любой OpenAI-совместимый провайдер ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MODEL_FAST=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Только для локальной разработки: явный демо-ответ без предложений.
DEMO_MODE=false
