{
 "uid": "odin-overview",
 "title": "О!дин запрос — обзор",
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Сайт доступен",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bool_on_off"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_success{job=\"blackbox_http\"}",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Время ответа",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 16,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_duration_seconds{job=\"blackbox_http\"}",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "CPU сервера",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
     "legendFormat": "cpu"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Память сервера (доступно)",
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemAvailable_bytes",
     "legendFormat": "available"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Диск / (свободно)",
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
     "legendFormat": "free"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Память контейнеров",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "container_memory_working_set_bytes{name=~\"odin-zapros-.+\"}",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "CPU контейнеров",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(container_cpu_usage_seconds_total{name=~\"odin-zapros-.+\"}[5m])",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Перезапуски / uptime контейнеров",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - container_start_time_seconds{name=~\"odin-zapros-.+\"}",
     "legendFormat": "{{name}}"
    }
   ]
  }
 ]
}