# cp .env.example .env — дефолты рабочие для docker compose.

# --- приложение ---
APP_PORT=8080
LOG_LEVEL=INFO

# --- PostgreSQL (compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=trip
# в compose хост — db; для локального запуска без Docker замените на localhost
DATABASE_URL=postgresql://app:app@db:5432/trip

# --- LLM: любой OpenAI-совместимый провайдер ---
# Примеры LLM_BASE_URL: https://api.openai.com/v1 · https://openrouter.ai/api/v1 · https://api.deepseek.com/v1
# · локальная Ollama из контейнера: http://host.docker.internal:11434/v1 (ключ не нужен)
# Без ключа UI открывается, а чат честно отвечает, что ключ не задан (GET /api/status это показывает).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MODEL_FAST=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# auto: JSON-режим, если провайдер его поддерживает (иначе отключается сам); off: не отправлять response_format
LLM_JSON_MODE=auto

# --- поставщик travel data ---
# demo — существующий детерминированный каталог; tutu — реальные read-only ответы MCP
TRAVEL_DATA_PROVIDER=demo   
TUTU_MCP_ENDPOINT=https://mcp.tutu.ru/mcp
TUTU_TIMEOUT_SECONDS=25
# Локальные защитные лимиты одного поиска, это не лимиты, заявленные Туту
TUTU_MAX_CALLS=18
TUTU_MAX_PARALLEL=2
